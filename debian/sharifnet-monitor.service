[Unit]
Description=SharifNet Automatic Reconnection Monitor
After=network-online.target
Wants=network-online.target

[Service]
Type=simple

ExecStart=/usr/bin/sharifnet monitor

Restart=on-failure
RestartSec=10

StandardOutput=journal
StandardError=journal

NoNewPrivileges=true

[Install]
WantedBy=default.target